# Copy this file to .env and adjust as needed.
# Loaded by scripts/start.sh and exported to each native process.

# --- LLM (scene/script breakdown) ---
# Pulled into local Ollama on first run of scripts/setup.sh.
# llama3.1:8b is a reasonable default; swap to a larger model if your
# hardware can take it.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Appended to every generated scene's image prompt. Default evokes the
# watercolor coastal reference style used when this project was set up.
ILLUSTRATION_STYLE_HINT="soft vibrant watercolor painting, loose expressive brushstrokes, warm sunlit coastal palette, lush greenery and wildflowers, romantic and gentle mood"

# --- Image generation (ComfyUI + FLUX) ---
COMFYUI_BASE_URL=http://localhost:8188
# Must match a checkpoint/unet filename placed under comfyui/models (see
# README) - defaults target FLUX.1-schnell.
FLUX_UNET_NAME=flux1-schnell.safetensors
FLUX_CLIP_NAME1=clip_l.safetensors
FLUX_CLIP_NAME2=t5xxl_fp8_e4m3fn.safetensors
FLUX_VAE_NAME=ae.safetensors

# Copy this file to .env and adjust as needed.
# Loaded by scripts/start.sh and exported to each native process.

# --- LLM (scene/script breakdown) ---
# Pulled into local Ollama on first run of scripts/setup.sh.
# llama3.1:8b is a reasonable default; swap to a larger model if your
# hardware can take it.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Appended to every generated scene's image prompt. Gothic ink/bone/rose
# style from specs/Novella Comic Generator Design.zip's "Art Direction" sheet
# (one light source, mostly ink, flat printed shading, single rose accent).
ILLUSTRATION_STYLE_HINT="gothic ink-and-paper comic illustration, one dramatic light source casting deep ink-black shadows, high contrast between black ink and pale bone-white highlights, muted palette of black ink, bone white and a single rose-pink accent color, flat printed shading with crosshatching and halftone dots rather than airbrushed gradients, strong graphic silhouettes, vignette falling to black at the panel edges, moody gothic atmosphere"

# --- Image generation (ComfyUI + FLUX) ---
COMFYUI_BASE_URL=http://localhost:8188
# Must match a checkpoint/unet filename placed under comfyui/models (see
# README) - defaults target FLUX.1-schnell.
FLUX_UNET_NAME=flux1-schnell.safetensors
FLUX_CLIP_NAME1=clip_l.safetensors
FLUX_CLIP_NAME2=t5xxl_fp8_e4m3fn.safetensors
FLUX_VAE_NAME=ae.safetensors
